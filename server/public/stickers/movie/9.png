<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Face -->
  <circle cx="90" cy="110" r="65" fill="#FACC15" stroke="#111827" stroke-width="6"/>
  <!-- Sleeping Closed Eyes -->
  <path d="M 65,100 Q 78,110 90,100" fill="none" stroke="#111827" stroke-width="6" stroke-linecap="round"/>
  <path d="M 105,100 Q 118,110 130,100" fill="none" stroke="#111827" stroke-width="6" stroke-linecap="round"/>
  <!-- Gentle Smile/Mouth -->
  <ellipse cx="98" cy="130" rx="12" ry="8" fill="#111827"/>
  <!-- Snooze Snot Bubble -->
  <circle cx="118" cy="118" r="16" fill="#38BDF8" stroke="#0284C7" stroke-width="4" opacity="0.85"/>
  <circle cx="113" cy="113" r="4" fill="#FFFFFF"/>
  <!-- Floating Zzz -->
  <text x="145" y="65" font-family="Arial, sans-serif" font-weight="900" font-size="28" fill="#60A5FA" stroke="#111827" stroke-width="2">Z</text>
  <text x="165" y="45" font-family="Arial, sans-serif" font-weight="900" font-size="22" fill="#93C5FD" stroke="#111827" stroke-width="2">z</text>
  <text x="178" y="30" font-family="Arial, sans-serif" font-weight="900" font-size="16" fill="#BFDBFE" stroke="#111827" stroke-width="2">z</text>
</svg>