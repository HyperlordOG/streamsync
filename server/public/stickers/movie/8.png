<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="cloud" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F97316"/>
      <stop offset="50%" stop-color="#EF4444"/>
      <stop offset="100%" stop-color="#7C2D12"/>
    </linearGradient>
  </defs>
  <!-- Face Bottom Half -->
  <path d="M 50,105 C 50,155 150,155 150,105 Z" fill="#FACC15" stroke="#111827" stroke-width="6"/>
  <!-- Stunned Eyes -->
  <circle cx="75" cy="118" r="8" fill="#111827"/>
  <circle cx="125" cy="118" r="8" fill="#111827"/>
  <!-- Open Mouth -->
  <ellipse cx="100" cy="138" rx="14" ry="10" fill="#111827"/>
  <!-- Exploding Cloud / Brain Top -->
  <path d="M 50,105 C 30,95 25,65 50,55 C 45,35 75,20 100,30 C 125,20 155,35 150,55 C 175,65 170,95 150,105 Z" fill="url(#cloud)" stroke="#111827" stroke-width="6" stroke-linejoin="round"/>
  <!-- Sparks & stars -->
  <path d="M 100,10 L 100,22 M 40,25 L 50,35 M 160,25 L 150,35" stroke="#FBBF24" stroke-width="5" stroke-linecap="round"/>
  <circle cx="90" cy="50" r="4" fill="#FEF08A"/>
  <circle cx="120" cy="65" r="5" fill="#FEF08A"/>
</svg>