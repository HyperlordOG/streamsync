{
  "manifest_version": 3,
  "name": "StreamSync - Synchronized Watch Party",
  "version": "1.0.0",
  "description": "Watch movies and shows together in real-time synchronization on Netflix, Prime Video, YouTube, and Web streams.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.youtube.com/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StreamSync Watch Party",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "dist/bridge.bundle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "dist/content.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/bridge.bundle.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
