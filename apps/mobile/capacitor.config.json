{
  "appId": "org.streamsync.app",
  "appName": "StreamSync",
  "webDir": "www",
  "server": {
    "url": "https://streamconnectroshni.duckdns.org",
    "cleartext": false,
    "allowNavigation": [
      "*.duckdns.org",
      "*.netflix.com",
      "*.netflix.net",
      "*.nflximg.net",
      "*.nflxvideo.net",
      "*.nflxext.com",
      "*.primevideo.com",
      "*.amazon.com",
      "*.amazon.in",
      "*.amazon.co.uk",
      "*.amazon.de",
      "*.amazon.ca",
      "*.media-amazon.com",
      "*.aiv-cdn.net",
      "*.aiv-delivery.net",
      "*.youtube.com",
      "*.googlevideo.com",
      "*.disneyplus.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#0f172a"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#0f172a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  }
}

